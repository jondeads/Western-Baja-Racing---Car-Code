void GPSCaptureNMEA() {
  static char line[120];
  static uint8_t idx = 0;

  int moved = 0;
  while (GPS.available() && moved < 256) {
    char c = (char)GPS.read();
    moved++;

    if (c == '\r') continue;

    if (c == '\n') {
      line[idx] = '\0';
      idx = 0;

      // Only keep RMC/GGA (GN or GP)
      bool ok =
        (strncmp(line, "$GPRMC", 6) == 0) || (strncmp(line, "$GNRMC", 6) == 0) ||
        (strncmp(line, "$GPGGA", 6) == 0) || (strncmp(line, "$GNGGA", 6) == 0);

      if (ok) {
        // Copy + SANITIZE so it doesn't break CSV:
        // - replace commas with ';'
        // - replace any quotes with apostrophe
        // - limit length to lastNMEA buffer
        size_t w = 0;
        for (size_t i = 0; line[i] && w < sizeof(lastNMEA) - 1; i++) {
          char ch = line[i];
          if (ch == ',') ch = ';';
          if (ch == '"') ch = '\'';
          lastNMEA[w++] = ch;
        }
        lastNMEA[w] = '\0';
        lastNMEAMs = millis();
      }
      continue;
    }

    if (idx < sizeof(line) - 1) {
      line[idx++] = c;
    } else {
      idx = 0; // overflow reset
    }
  }
}

void exportNMEAtoPhone() {
  static uint32_t lastSend = 0;
  if (millis() - lastSend < 1500) return; // 1 Hz
  lastSend = millis();

  GPSCaptureNMEA();
  if (lastNMEA[0] == '\0') return;

  char out[140];
  int n = snprintf(out, sizeof(out), "NMEA,%lu,\"%s\"\n",
                   (unsigned long)lastNMEAMs, lastNMEA);
  if (n > 0 && n < (int)sizeof(out)) safePhoneWrite((uint8_t*)out, (size_t)n);
}



