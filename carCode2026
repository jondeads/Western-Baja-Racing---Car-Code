#define WHO_AM_I      0x75
#define SMPLRT_DIV    0x19
#define CONFIG_REG    0x1A
#define GYRO_CONFIG   0x1B
#define ACCEL_CONFIG  0x1C
#define ACCEL_CONFIG2 0x1D

bool imuHandleFail() {
  imuOK = 0;

  // Clear values so stale data is obvious
  ax = ay = az = 0;
  gx = gy = gz = 0;

  // Hard bus recovery
  I2C_IMU.end();
  delay(2);

  i2cBusRecover(gyroData, gyroClock);
  delay(2);

  I2C_IMU.begin(gyroData, gyroClock, 25000);
  I2C_IMU.setTimeout(2);
  delay(2);

  return false;
}

bool imuWriteReg(uint8_t reg, uint8_t val) {
  I2C_IMU.beginTransmission(MPU_ADDR);
  I2C_IMU.write(reg);
  I2C_IMU.write(val);

  uint8_t e = I2C_IMU.endTransmission(true);
  if (e != 0) {
    return imuHandleFail();
  }
  return true;
}

uint8_t imuRead8(uint8_t reg) {
  I2C_IMU.beginTransmission(MPU_ADDR);
  I2C_IMU.write(reg);

  uint8_t e = I2C_IMU.endTransmission(false);
  if (e != 0) {
    imuHandleFail();
    return 0xFF;
  }

  uint8_t n = I2C_IMU.requestFrom(MPU_ADDR, (uint8_t)1, (uint8_t)true);
  if (n != 1) {
    imuHandleFail();
    return 0xFF;
  }

  return I2C_IMU.read();
}

bool imuPing() {
  I2C_IMU.beginTransmission(MPU_ADDR);
  uint8_t e = I2C_IMU.endTransmission(true);
  return (e == 0);
}

bool imuWhoAmICheck() {
  uint8_t who = imuRead8(WHO_AM_I);
  return (who == 0x68 || who == 0x70 || who == 0x71);
}

bool imuTryInit() {
  I2C_IMU.end();
  delay(2);

  i2cBusRecover(gyroData, gyroClock);
  delay(2);

  I2C_IMU.begin(gyroData, gyroClock, 25000);
  I2C_IMU.setTimeout(2);
  delay(20);

  if (!imuPing()) return false;

  if (!imuWriteReg(PWR_MGMT_1, 0x00)) return false;   // wake up
  delay(10);

  uint8_t who = imuRead8(WHO_AM_I);
  if (!(who == 0x68 || who == 0x70 || who == 0x71)) {
    return false;
  }

  // Conservative settings
  if (!imuWriteReg(SMPLRT_DIV, 0x09)) return false;    // modest rate
  if (!imuWriteReg(CONFIG_REG, 0x06)) return false;    // DLPF
  if (!imuWriteReg(GYRO_CONFIG, 0x00)) return false;   // ±250 dps
  if (!imuWriteReg(ACCEL_CONFIG, 0x00)) return false;  // ±2g
  if (!imuWriteReg(ACCEL_CONFIG2, 0x06)) return false; // accel DLPF

  ax = ay = az = 0;
  gx = gy = gz = 0;

  return true;
}

void imuService() {
  if (imuOK) return;

  unsigned long now = millis();
  if (now - imuLastAttemptMs < imuRetryIntervalMs) return;

  imuLastAttemptMs = now;

  if (imuTryInit()) {
    imuOK = 1;
    imuEverOK = true;
    imuRetryIntervalMs = 1000;
    Phone.println("GyroConnected");
  } else {
    imuOK = 0;
    imuRetryIntervalMs = min(imuRetryIntervalMs * 2, IMU_RETRY_MAX_MS);
    Phone.println("GyroRetry");
  }
}

bool readGyro() {
  if (!imuOK) return false;

  I2C_IMU.beginTransmission(MPU_ADDR);
  I2C_IMU.write(ACCEL_XOUT_H);

  uint8_t e = I2C_IMU.endTransmission(false);
  if (e != 0) {
    return imuHandleFail();
  }

  uint8_t n = I2C_IMU.requestFrom(MPU_ADDR, (uint8_t)14, (uint8_t)true);
  if (n != 14) {
    return imuHandleFail();
  }

  ax = ((int16_t)I2C_IMU.read() << 8) | I2C_IMU.read();
  ay = ((int16_t)I2C_IMU.read() << 8) | I2C_IMU.read();
  az = ((int16_t)I2C_IMU.read() << 8) | I2C_IMU.read();

  I2C_IMU.read(); // temp high
  I2C_IMU.read(); // temp low

  gx = ((int16_t)I2C_IMU.read() << 8) | I2C_IMU.read();
  gy = ((int16_t)I2C_IMU.read() << 8) | I2C_IMU.read();
  gz = ((int16_t)I2C_IMU.read() << 8) | I2C_IMU.read();

  return true;
}

void imuScanBus() {
  int found = 0;
  for (uint8_t addr = 1; addr < 127; addr++) {
    I2C_IMU.beginTransmission(addr);
    uint8_t err = I2C_IMU.endTransmission(true);
    if (err == 0) {
      found++;
    }
    delay(1);
  }
}

void i2cBusRecover(int sda, int scl) {
  pinMode(sda, INPUT_PULLUP);
  pinMode(scl, OUTPUT_OPEN_DRAIN);

  digitalWrite(scl, HIGH);
  delayMicroseconds(5);

  // Clock out any stuck slave state
  for (int i = 0; i < 16; i++) {
    if (digitalRead(sda) == HIGH) break;
    digitalWrite(scl, LOW);
    delayMicroseconds(8);
    digitalWrite(scl, HIGH);
    delayMicroseconds(8);
  }

  // STOP condition
  pinMode(sda, OUTPUT_OPEN_DRAIN);
  digitalWrite(sda, LOW);
  delayMicroseconds(8);
  digitalWrite(scl, HIGH);
  delayMicroseconds(8);
  digitalWrite(sda, HIGH);
  delayMicroseconds(8);

  pinMode(sda, INPUT_PULLUP);
  pinMode(scl, INPUT_PULLUP);
}
