// Function to read data from Pi via UART
void readPiData() {
    int bytesRead = 0;
    const int MAX_BYTES_PER_LOOP = 32;  // Limit bytes per loop iteration
    
    while (Pi.available() > 0 && bytesRead < MAX_BYTES_PER_LOOP) {
        char c = Pi.read();
        bytesRead++;
        
        if (c == '\n' || c == '\r') {
            if (incomingPiData.length() > 0) {
                processPiData(incomingPiData);
                incomingPiData = "";
            }
        } else if (incomingPiData.length() < MAX_PI_BUFFER) {
            incomingPiData += c;
        } else {
            // Buffer overflow protection - discard and reset
            incomingPiData = "";
            // Serial.println("Pi buffer overflow - reset");
        }
    }
    
    // Clear excessive backlog if buffer is getting too full
    if (Pi.available() > 128) {
        // Serial.println("Warning: Pi RX buffer high, clearing excess");
        while (Pi.available() > 64) {
            Pi.read();  // Discard oldest data
        }
    }
}

