    Phone.println("USB debug mode enabled: GPS on UART0 is disabled in this mode.");
  #endif
#else
    Phone.begin(115200, SERIAL_8N1, backUpExtRx, backUpExtTx);
#endif
    Pi.begin(115200, SERIAL_8N1, piRx, piTx);  // Initialize Pi UART communication

#if USB_PHONE_DEBUG
  #if USB_SHARE_UART0_WITH_GPS
    GPS.begin(GPS_BAUD, SERIAL_8N1, gpsRx, gpsTx);
  #else
