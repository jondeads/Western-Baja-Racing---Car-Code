//function to collect voltage of batteries, can be called for both bats
void batRead(int batteryPin, int &rawValue, int &percentage, int* logger, int &index) {
    rawValue = analogRead(batteryPin); // Read raw analog value

    if (rawValue > batLowLimit) {
        updateBatAverage(rawValue, logger, index, percentage);
    }
}

// called from within bat read, takes moving average of battery voltage
void updateBatAverage(int rawValue, int* logger, int &index, int &percentage) {
    logger[index] = rawValue;
    index = (index + 1) % batSamples;

    long sum = 0;
    for (int i = 0; i < batSamples; i++) {
        sum += logger[i];
    }

    percentage = map(sum / batSamples, batLowLimit, batHighLimit, 0, 100);
    if (percentage < 0) percentage = 0;
}

