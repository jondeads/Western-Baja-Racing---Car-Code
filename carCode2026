        uint8_t receivedData = buttonData.toInt();
        
        // ADD THIS DEBUG OUTPUT TO SEE THE PARSED VALUES
        // Serial.print("Button data parsed: ");
        // Serial.print(buttonData);
        // Serial.print(" -> decimal: ");
        // Serial.print(receivedData);
        // Serial.print(" -> binary: ");
        // Serial.println(receivedData, BIN);
        
        processPiButtons(receivedData);
    }
    else if (data.startsWith("HORN_ALLOW:")) {
        String allowData = data.substring(12);
        allowedHorn = allowData.toInt();
