        resetPressTime = 0;  // Reset press time if not all buttons pressed
    }

    // --- Button 1: Press-and-hold for 3s to toggle panic, double-tap for mode ---
    if (button1Pressed) {
        if (button1PressTime == 0) {
            button1PressTime = millis();  // Start timing
        } else if (!button1Held && millis() - button1PressTime >= 3000) {
            panicStatus = !panicStatus;
            button1Held = true;  // Prevent retriggering
        }
    } else {
        // Button 1 was released
        if (button1PressTime > 0) {
            unsigned long pressDuration = millis() - button1PressTime;
            
            if (button1Held) {
                // This was a long press (panic), don't process as mode change
                button1Held = false;
            } else if (pressDuration < 3000) {
                // This was a short press, check for double-tap mode change
                currentReleaseTime = millis();
                if (currentReleaseTime - lastReleaseTime <= doubleReleaseThreshold) {
                    releaseCount++;
                    if (releaseCount == 2) {
                        mode = (mode + 1) % 3;
                        releaseCount = 0;
                    }
                } else {
                    releaseCount = 1;
                }
                lastReleaseTime = currentReleaseTime;
            }
            // If pressDuration >= 3000 but button1Held wasn't set, ignore it
            
            button1PressTime = 0;  // Reset press time
        }
    }

    // --- Button 2: FILTERED mute toggle ---
    if ((changedButtons & (1 << 1)) && button2Pressed && !lastButton2State) {
        unsigned long currentTime = millis();
        
        // FILTER: Ignore button 2 if it happens too close to button 1 activity
        if (button1PressTime > 0 && (currentTime - button1PressTime) < 200) {
            // Serial.println("Button 2 press FILTERED - too close to button 1 press");
        }
        // FILTER: Ignore rapid button 2 changes (debounce)
        else if (currentTime - lastButton2ChangeTime < BUTTON2_DEBOUNCE) {
            // Serial.println("Button 2 press FILTERED - too rapid");
        }
        // FILTER: Ignore if button 1 is currently held for panic
        else if (button1Held) {
            // Serial.println("Button 2 press FILTERED - button 1 is held for panic");
        }
        else {
            muteStatus = !muteStatus;
            // Serial.println("MUTE TOGGLED! (Legitimate button 2 press)");
        }
        
        lastButton2ChangeTime = currentTime;
    }
    lastButton2State = button2Pressed;

    // --- Button 3: Toggle two step ---
    if ((changedButtons & (1 << 2)) && button3Pressed) {
        twoStep = !twoStep;
        // Serial.println("Two step toggled!");
    }
    
    // --- Button 4: Horn control ---
    if ((changedButtons & (1 << 3))) {
        hornButton = button4Pressed ? 1 : 0;
        // Serial.print("Horn button: ");
        // Serial.println(hornButton);
    }

    // Optional: Print button state changes (for debugging)
    for (int i = 0; i < BUTTON_COUNT; i++) {
        if (changedButtons & (1 << i)) {
            if (receivedData & (1 << i)) {
                // Serial.print("Button ");
                // Serial.print(i + 1);
                // Serial.println(" pressed!");
            } else {
                // Serial.print("Button ");
                // Serial.print(i + 1);
                // Serial.println(" released!");
            }
        }
    }
    lastButtonStates = receivedData;
}

//function to format a miliseconds time to a string in the form HHMMSS
void formatTime(long timeInMillis, String &formattedTime) {
    int seconds = timeInMillis / 1000;
    int minutes = seconds / 60;
    seconds = seconds % 60;
    int hours = minutes / 60;
    minutes = minutes % 60;

    formattedTime = String(hours) + String(minutes) + String(seconds);
}   

