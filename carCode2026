// Function to read data from phone
void readPhoneData() {
    int bytesRead = 0;
    const int MAX_BYTES_PER_LOOP = 32;  // Limit bytes per loop iteration
    
    while (Phone.available() > 0 && bytesRead < MAX_BYTES_PER_LOOP) {
      char c = Phone.read();
      bytesRead++;
  
      // Check if a complete message has been received
      if (c == ',') {
        // Process the complete message
        processPhoneData(incomingPhoneData);
  
        // Clear the buffer for the next message
        incomingPhoneData = "";
      } else if(c != '\n'){
        incomingPhoneData += c;
      }
    }
    
    // Clear excessive backlog if buffer is getting too full
    if (Phone.available() > 128) {
        // Serial.println("Warning: Phone RX buffer high, clearing excess");
        while (Phone.available() > 64) {
            Phone.read();  // Discard oldest data
        }
    }
}

