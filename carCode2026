    attachInterrupt(digitalPinToInterrupt(fuelSens), fuelRead, CHANGE);
    attachInterrupt(digitalPinToInterrupt(rpmSens), RPMRead, FALLING);
    attachInterrupt(digitalPinToInterrupt(wheelSpeedSens), wheelSpeedRead, FALLING); 
}

void loop(){
  // ALWAYS read both UART buffers first to prevent overflow
  readAndPackageGPS();

#if !(USB_PHONE_DEBUG && USB_SHARE_UART0_WITH_GPS)
  readPhoneData();
#endif

  readPiData();

  reverseCheck();

  

  if (millis() - phoneExportTimer >= phoneExportInterval) {
    rpmCalculate();

    wheelSpeedCalculate();

    batRead(battery1, rawBattery1, battPercentage1, batLogger1, batIndex1);
    batRead(battery2, rawBattery2, battPercentage2, batLogger2, batIndex2);

    shockRead();

    exportPhoneData();

    phoneExportTimer = millis();
  }

  if (millis() - piCommTimer >= piCommInterval) {
    imuService();

    if (imuOK) {
      if (!readGyro()) {
        Phone.println("GyroReadFail");
      }
    }

    GPSProcess();
    formatPidata();
    exportPiData();

    piCommTimer = millis();
  }
                                                                                                                                                

    
    // Monitor buffer levels periodically
    monitorBuffers();
}

