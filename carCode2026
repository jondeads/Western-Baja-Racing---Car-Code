// Function to read fuel sensor and update fuel level using PWM
void fuelRead() {
    if (digitalRead(fuelSens) == HIGH && fuelFlag == 0) {
      fuelStart = micros();
      fuelFlag = 1;
    } else if (digitalRead(fuelSens) == LOW && fuelFlag == 1) {
      fuelEnd = micros();
      fuelFlag = 0;
      newFuelTime = 1;
    }
  
    fuelTime = fuelEnd - fuelStart;
  
    if (fuelFlag == 0 && fuelTime > fuelLowLimit && fuelTime < fuelHighLimit && newFuelTime == 1) {
      updateFuelAverage(fuelTime);
      newFuelTime = 0;
    }
  }
  
  // Function to update moving average of PWM samples
void updateFuelAverage(int newValue) {
    fuelLogger[fuelIndex] = newValue;
    fuelIndex = (fuelIndex + 1) % fuelSamples;
  
    long sum = 0;
  
    for (int i = 0; i < fuelSamples; i++) {
      sum += fuelLogger[i];
    }
  
    rawFuel = sum / fuelSamples;
  
    fuel = map(rawFuel, fuelLowLimit, fuelHighLimit, 0, 99);
  }

// Function to calculate RPM from pulse time
void RPMRead() {
    rpmPulseTime = micros();

    if (motorLocation == 2) {      //to determine position in rotatuon relative to the magnets
      motorLocation = 0;
    }else{
      motorLocation ++;
    }
  
    if (rpmPulseTime < rpmPrevPulseTime) {
      // Rollover detected
      magInterval = (4294967295 - rpmPrevPulseTime) + rpmPulseTime;
    } else {
      magInterval = rpmPulseTime - rpmPrevPulseTime;
    }
  
    if (magInterval > magnetDebounce) {
      // rpmCalculate();
      // Store pulse time
      rpmPrevPulseTime = rpmPulseTime;
    }
  }

// Function to calculate RPM from magnetic interval
void rpmCalculate() {
    if (magInterval > 0) {
      // Convert difference into frequency (seconds domain)
      magFreq = 60000000 / magInterval;
    }
  
    // Compensate for pulses per rotation
    rpm = magFreq / magnets;
  }

//function to colect wheel speed input
void wheelSpeedRead(){
    wheelPulseTime = micros();

    // Handle micros() overflow
    if (wheelPulseTime < wheelPrevPulseTime) {
      toothInterval = (4294967295 - wheelPrevPulseTime) + wheelPulseTime;
    } else {
      toothInterval = wheelPulseTime - wheelPrevPulseTime;
    }
    
    if (toothInterval > 150 ) { // Avoid noise
      // wheelSpeedCalculate();
      wheelPrevPulseTime = wheelPulseTime;
    }
}

//calculate wheel speed using RPM of gearbox output and ratio to front tires
void wheelSpeedCalculate() {
    if (toothInterval > 0) {
      toothFreq = 60000000 / toothInterval; // Frequency in Hz
      wheelSpeed = (toothFreq / (float)teeth) * wheelRatio;                       // RPM = frequency / teeth per rotation
      wheelSpeed = round(wheelSpeed * 10.0) / 10.0; // Round to 1 decimal place
    }
  }

