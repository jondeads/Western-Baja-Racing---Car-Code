    }

    incomingPhoneData.reserve(128);
    incomingPiData.reserve(256);
    piDataString.reserve(256);
    
    // Initialize battery samples array
    for (int i = 0; i < batSamples; i++) {
        batLogger1[i] = batLowLimit;
        batLogger2[i] = batLowLimit; // Initialize all samples to the low limit
    }

    for (int i = 0; i < fuelSamples; i++) {
        fuelLogger[i] = batLowLimit;
