#include <Arduino.h>
#include <Wire.h>
#include <math.h>
 
// ============================================================================
// Western Baja Racing - MPU-6050 IMU (Accelerometer + Gyroscope) Telemetry
// ============================================================================
// Default I2C address is 0x68 (when AD0 pin is LOW).
const uint8_t ADDR = 0x68;
 
// Default sensitivity scale factors after waking the MPU-6050:
// - Accelerometer (+/- 2g default range): 16,384 LSB per g
//   Note: For Baja off-road jump landings & impacts (up to +/- 16g), see setup()
//   for optional register 0x1C configuration.
// - Gyroscope (+/- 250 deg/s default range): 131.0 LSB per deg/s
const float ACCEL_SCALE = 16384.0f;
const float GYRO_SCALE  = 131.0f;
 
// Set to true if you want single-line compact table rows instead of multi-line cards
const bool COMPACT_TABLE_MODE = false;
 
// Calibrated startup offsets (automatically measured in setup while car is still)
float gyroOffsetX = 0.0f;
float gyroOffsetY = 0.0f;
float gyroOffsetZ = 0.0f;
 
uint8_t readReg(uint8_t reg) {
  Wire.beginTransmission(ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(ADDR, (uint8_t)1);
  return Wire.available() ? Wire.read() : 0xFF;
}
 
void writeReg(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}
 
// Helper to classify vehicle motion state in plain English
const char* describeRotationRate(float dps, const char* posDir, const char* negDir) {
  if (fabs(dps) < 2.0f) return "Steady";
  if (dps > 0.0f) return posDir;
  return negDir;
}
 
void calibrateGyro(int samples = 200) {
  Serial.println("Calibrating gyroscope zero-offset (keep sensor stationary)...");
  long sumX = 0, sumY = 0, sumZ = 0;
  int validSamples = 0;
 
  for (int i = 0; i < samples; i++) {
    Wire.beginTransmission(ADDR);
    Wire.write(0x43); // GYRO_XOUT_H
    Wire.endTransmission(false);
    Wire.requestFrom(ADDR, (uint8_t)6);
 
    if (Wire.available() >= 6) {
      int16_t gx = (Wire.read() << 8) | Wire.read();
      int16_t gy = (Wire.read() << 8) | Wire.read();
      int16_t gz = (Wire.read() << 8) | Wire.read();
      sumX += gx;
      sumY += gy;
      sumZ += gz;
      validSamples++;
    }
    delay(5);
  }
 
  if (validSamples > 0) {
    gyroOffsetX = (sumX / (float)validSamples) / GYRO_SCALE;
    gyroOffsetY = (sumY / (float)validSamples) / GYRO_SCALE;
    gyroOffsetZ = (sumZ / (float)validSamples) / GYRO_SCALE;
  }
 
  Serial.print("Calibration complete! Offsets (deg/s) -> Roll: ");
  Serial.print(gyroOffsetX, 2);
  Serial.print(", Pitch: ");
  Serial.print(gyroOffsetY, 2);
  Serial.print(", Yaw: ");
  Serial.println(gyroOffsetZ, 2);
  Serial.println();
}
 
void setup() {
  Serial.begin(115200);
  delay(2000);
 
  Serial.println("============================================================");
  Serial.println("   WESTERN BAJA RACING - MPU-6050 IMU TELEMETRY MONITOR     ");
  Serial.println("============================================================");
  Serial.println("Starting I2C bus scanner...");
 
  Wire.begin();
  Serial.println("I2C initialized.");
 
  for (byte address = 1; address < 127; address++) {
    Wire.beginTransmission(address);
    byte error = Wire.endTransmission();
 
    if (error == 0) {
      Serial.print(" -> I2C device found at 0x");
      if (address < 16) Serial.print("0");
      Serial.println(address, HEX);
    }
  }
  Serial.println("Scan finished.");
 
  // Wake the chip (starts in sleep mode by default)
  writeReg(0x6B, 0x00); // PWR_MGMT_1 = 0x00 (internal 8MHz oscillator, wake up)
  delay(100);
 
  // Enable built-in Digital Low Pass Filter (DLPF ~21 Hz) to smooth out Baja engine vibration
  writeReg(0x1A, 0x04); // CONFIG register: DLPF_CFG = 4 (21 Hz bandwidth)
 
  // Verify chip identity
  uint8_t id = readReg(0x75); // WHO_AM_I register
  Serial.print("Sensor ID (WHO_AM_I) = 0x");
  Serial.print(id, HEX);
  if (id == 0x68) {
    Serial.println(" [MPU-6050 Verified OK]");
  } else {
    Serial.println(" [Unexpected ID - check wiring]");
  }
 
  // Zero out resting gyroscope drift
  calibrateGyro(200);
 
  if (COMPACT_TABLE_MODE) {
    Serial.println("Accel X(g) | Accel Y(g) | Accel Z(g) | Pitch(deg) | Roll(deg) | Roll Rate(d/s) | Pitch Rate(d/s) | Yaw Rate(d/s) | Temp(C)");
  }
}
 
void loop() {
  // Burst-read all 14 sensor data registers (0x3B through 0x48)
  Wire.beginTransmission(ADDR);
  Wire.write(0x3B); // ACCEL_XOUT_H
  Wire.endTransmission(false);
  Wire.requestFrom(ADDR, (uint8_t)14);
 
  if (Wire.available() < 14) {
    Serial.println("[WARNING] I2C Read failed - fewer than 14 bytes received! Check harness/connections.");
    delay(500);
    return;
  }
 
  // Combine High and Low bytes into signed 16-bit integers (-32,768 to +32,767)
  int16_t rawAx   = (Wire.read() << 8) | Wire.read(); // 0x3B (H), 0x3C (L)
  int16_t rawAy   = (Wire.read() << 8) | Wire.read(); // 0x3D (H), 0x3E (L)
  int16_t rawAz   = (Wire.read() << 8) | Wire.read(); // 0x3F (H), 0x40 (L)
  int16_t rawTemp = (Wire.read() << 8) | Wire.read(); // 0x41 (H), 0x42 (L)
  int16_t rawGx   = (Wire.read() << 8) | Wire.read(); // 0x43 (H), 0x44 (L)
  int16_t rawGy   = (Wire.read() << 8) | Wire.read(); // 0x45 (H), 0x46 (L)
  int16_t rawGz   = (Wire.read() << 8) | Wire.read(); // 0x47 (H), 0x48 (L)
 
  // 1. Convert raw 16-bit counts to Linear Acceleration in g-force (1g = 9.81 m/s^2)
  float accelX_g = rawAx / ACCEL_SCALE; // Forward (+) / Backward (-)
  float accelY_g = rawAy / ACCEL_SCALE; // Left (+) / Right (-)
  float accelZ_g = rawAz / ACCEL_SCALE; // Upward (+1.0g when flat due to gravity)
  float totalG   = sqrt(accelX_g * accelX_g + accelY_g * accelY_g + accelZ_g * accelZ_g);
 
  // 2. Convert raw 16-bit counts to Angular Velocity in degrees/second (minus startup drift)
  float rollRate_dps  = (rawGx / GYRO_SCALE) - gyroOffsetX; // Tilting side-to-side (X-axis)
  float pitchRate_dps = (rawGy / GYRO_SCALE) - gyroOffsetY; // Nose tilting up/down (Y-axis)
  float yawRate_dps   = (rawGz / GYRO_SCALE) - gyroOffsetZ; // Turning left/right (Z-axis)
 
  // 3. Calculate static chassis Tilt Angles (Pitch & Roll in degrees) from gravity vector
  float rollAngle_deg  = atan2(accelY_g, accelZ_g) * (180.0f / PI);
  float pitchAngle_deg = atan2(-accelX_g, sqrt(accelY_g * accelY_g + accelZ_g * accelZ_g)) * (180.0f / PI);
 
  // 4. Convert die temperature to Celsius (per MPU-6050 datasheet formula)
  float temp_C = (rawTemp / 340.0f) + 36.53f;
 
  if (COMPACT_TABLE_MODE) {
    // Single-line readable output with clear labels and units
    Serial.print("Accel [Fwd/Back: "); Serial.print(accelX_g, 2);
    Serial.print("g, Left/Right: ");   Serial.print(accelY_g, 2);
    Serial.print("g, Vertical: ");     Serial.print(accelZ_g, 2);
    Serial.print("g] | Tilt [Pitch: "); Serial.print(pitchAngle_deg, 1);
    Serial.print(" deg, Roll: ");       Serial.print(rollAngle_deg, 1);
    Serial.print(" deg] | Gyro Rate [Roll: "); Serial.print(rollRate_dps, 1);
    Serial.print(" deg/s, Pitch: ");           Serial.print(pitchRate_dps, 1);
    Serial.print(" deg/s, Yaw: ");             Serial.print(yawRate_dps, 1);
    Serial.print(" deg/s] | Temp: ");          Serial.print(temp_C, 1);
    Serial.println(" C");
  } else {
    // Multi-line human-readable telemetry readout
    Serial.println("------------------------------------------------------------");
    Serial.print("LINEAR ACCELERATION (g-force)  [Total Load: ");
    Serial.print(totalG, 2);
    Serial.println(" g]");
    Serial.print("  * X (Forward / Braking) : ");
    Serial.print(accelX_g, 2);
    Serial.print(" g  (");
    Serial.print(accelX_g * 9.81f, 2);
    Serial.println(" m/s^2)");
 
    Serial.print("  * Y (Lateral Cornering) : ");
    Serial.print(accelY_g, 2);
    Serial.print(" g  (");
    Serial.print(accelY_g * 9.81f, 2);
    Serial.println(" m/s^2)");
 
    Serial.print("  * Z (Vertical / Gravity): ");
    Serial.print(accelZ_g, 2);
    Serial.print(" g  (");
    Serial.print(accelZ_g * 9.81f, 2);
    Serial.println(" m/s^2 -> ~1.00 g when flat)");
 
    Serial.println("CHASSIS TILT ANGLE (from gravity)");
    Serial.print("  * Pitch (Nose Up/Down)  : ");
    Serial.print(pitchAngle_deg, 1);
    Serial.println(" deg");
    Serial.print("  * Roll  (Side Lean)     : ");
    Serial.print(rollAngle_deg, 1);
    Serial.println(" deg");
 
    Serial.println("GYROSCOPE ROTATION SPEED (degrees per second)");
    Serial.print("  * X-Axis (Roll Rate)    : ");
    Serial.print(rollRate_dps, 1);
    Serial.print(" deg/s  [");
    Serial.print(describeRotationRate(rollRate_dps, "Rolling Right", "Rolling Left"));
    Serial.println("]");
 
    Serial.print("  * Y-Axis (Pitch Rate)   : ");
    Serial.print(pitchRate_dps, 1);
    Serial.print(" deg/s  [");
    Serial.print(describeRotationRate(pitchRate_dps, "Nose Pitching Up", "Nose Pitching Down"));
    Serial.println("]");
 
    Serial.print("  * Z-Axis (Yaw / Turn)   : ");
    Serial.print(yawRate_dps, 1);
    Serial.print(" deg/s  [");
    Serial.print(describeRotationRate(yawRate_dps, "Turning Left", "Turning Right"));
    Serial.println("]");
 
    Serial.print("BOARD TEMPERATURE         : ");
    Serial.print(temp_C, 1);
    Serial.println(" C");
  }
 
  delay(200);
}
